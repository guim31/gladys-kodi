    {
      "key": "playback_started",
      "label": {
        "en": "Playback started",
        "fr": "Lecture démarrée",
        "de": "Wiedergabe gestartet",
        "es": "Reproducción iniciada"
      },
      "description": {
        "en": "Kodi starts playing something: a movie, an episode, the next song.",
        "fr": "Kodi commence à lire quelque chose : un film, un épisode, la chanson suivante.",
        "de": "Kodi beginnt etwas abzuspielen: einen Film, eine Folge, das nächste Lied.",
        "es": "Kodi empieza a reproducir algo: una película, un episodio, la siguiente canción."
      },
