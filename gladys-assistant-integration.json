{
  "manifest_version": 1,
  "type": "device",
  "name": "Kodi",
  "description": {
    "en": "Follow and control Kodi: what plays, volume, buttons, scenes when a movie starts.",
    "fr": "Suivez et pilotez Kodi : lecture en cours, volume, boutons, scènes au lancement d'un film.",
    "de": "Verfolge und steuere Kodi: aktuelle Wiedergabe, Lautstärke, Tasten, Szenen beim Filmstart.",
    "es": "Siga y controle Kodi: lo que se reproduce, volumen, botones, escenas al empezar una película."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-kodi:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-kodi/main/cover.png",
  "categories": ["multimedia"],
  "transports": ["local"],
  "network_discovery": [
    {
      "type": "mdns",
      "service": "_xbmc-jsonrpc-h._tcp"
    },
    {
      "type": "mdns",
      "service": "_xbmc-jsonrpc._tcp"
    }
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect your Kodi",
        "fr": "Connecter votre Kodi",
        "de": "Verbinde dein Kodi",
        "es": "Conecte su Kodi"
      },
      "description": {
        "en": "In Kodi, open Settings, Services, Control and turn on \"Allow remote control via HTTP\" and \"Allow remote control from applications on other systems\". Then click \"Find Kodi on the network\" below, or type its address. Up to three Kodi.",
        "fr": "Dans Kodi, ouvrez Paramètres, Services, Contrôle et activez « Autoriser le contrôle à distance via HTTP » et « Autoriser le contrôle à distance depuis des applications sur d'autres systèmes ». Cliquez ensuite sur « Chercher Kodi sur le réseau » plus bas, ou saisissez son adresse. Jusqu'à trois Kodi.",
        "de": "Öffne in Kodi Einstellungen, Dienste, Steuerung und aktiviere „Fernsteuerung via HTTP erlauben“ und „Fernsteuerung durch Anwendungen auf anderen Systemen erlauben“. Klicke dann unten auf „Kodi im Netzwerk suchen“ oder gib seine Adresse ein. Bis zu drei Kodi.",
        "es": "En Kodi, abra Ajustes, Servicios, Control y active «Permitir el control remoto vía HTTP» y «Permitir el control remoto desde aplicaciones de otros sistemas». Después pulse «Buscar Kodi en la red» más abajo, o introduzca su dirección. Hasta tres Kodi."
      },
      "links": [
        {
          "url": "https://kodi.wiki/view/Settings/Services/Control",
          "label": {
            "en": "Kodi: remote control settings",
            "fr": "Kodi : réglages du contrôle à distance",
            "de": "Kodi: Einstellungen der Fernsteuerung",
            "es": "Kodi: ajustes del control remoto"
          }
        }
      ]
    },
    {
      "key": "host_1",
      "type": "string",
      "label": {
        "en": "Kodi address",
        "fr": "Adresse de Kodi",
        "de": "Kodi-Adresse",
        "es": "Dirección de Kodi"
      },
      "placeholder": {
        "en": "e.g. 192.168.1.40",
        "fr": "ex. 192.168.1.40",
        "de": "z. B. 192.168.1.40",
        "es": "p. ej. 192.168.1.40"
      },
      "required": false,
      "default": "",
      "description": {
        "en": "IP address of the device running Kodi. Add :port if its web server does not use 8080.",
        "fr": "Adresse IP de l'appareil qui fait tourner Kodi. Ajoutez :port si son serveur web n'utilise pas 8080.",
        "de": "IP-Adresse des Geräts, auf dem Kodi läuft. Ergänze :Port, wenn sein Webserver nicht 8080 nutzt.",
        "es": "Dirección IP del equipo que ejecuta Kodi. Añada :puerto si su servidor web no usa el 8080."
      }
    },
    {
      "key": "username_1",
      "type": "string",
      "label": {
        "en": "User name",
        "fr": "Nom d'utilisateur",
        "de": "Benutzername",
        "es": "Usuario"
      },
      "placeholder": {
        "en": "kodi",
        "fr": "kodi",
        "de": "kodi",
        "es": "kodi"
      },
      "required": false,
      "default": "",
      "description": {
        "en": "Of Kodi's web server. Empty: kodi.",
        "fr": "Du serveur web de Kodi. Vide : kodi.",
        "de": "Des Kodi-Webservers. Leer: kodi.",
        "es": "Del servidor web de Kodi. Vacío: kodi."
      }
    },
    {
      "key": "password_1",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      },
      "required": false,
      "description": {
        "en": "Leave empty if Kodi asks for none.",
        "fr": "Laissez vide si Kodi n'en demande pas.",
        "de": "Leer lassen, wenn Kodi keines verlangt.",
        "es": "Déjelo vacío si Kodi no la pide."
      }
    },
