            "fr": "Kodi",
            "de": "Kodi",
            "es": "Kodi"
          }
        },
        {
          "key": "media_type",
          "type": "multi_select",
          "label": {
            "en": "Media types",
            "fr": "Types de média",
            "de": "Medientypen",
            "es": "Tipos de medio"
          },
          "options": [
            {
              "value": "movie",
              "label": {
                "en": "Movie",
                "fr": "Film",
                "de": "Film",
                "es": "Película"
              }
            },
            {
              "value": "episode",
