      "key": "find_kodi",
      "label": {
        "en": "Find Kodi on the network",
        "fr": "Chercher Kodi sur le réseau",
        "de": "Kodi im Netzwerk suchen",
        "es": "Buscar Kodi en la red"
      },
      "timeout_seconds": 30
